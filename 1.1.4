+								value = cell.getStringCellValue();
+								break;
+							default:
+								value = "";
+								break;
+						}
+						BeanUtils.setProperty(obj, name, value);
+					}
+				}
+				
+				return obj;
+			} catch (Exception e) {
+				throw new RuntimeException("Error reading Excel row", e);
+			}
+		}
